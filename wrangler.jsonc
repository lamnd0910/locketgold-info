{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locketgold-info",
  "main": "./worker/index.js",
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_date": "2026-09-29",
  "vars": {
    "SITE_URL": "https://locketgold.info",
    "NODNS_API_BASE_URL": "https://ctv.nodns.vn",
    "NODNS_CTV_PORTAL": "true",
    "NODNS_ADMIN_AUTH": "false",
    "NODNS_CREDENTIALS_ENABLED": "true",
    "ADMIN_USERNAME": "admin",
    "ADMIN_CREDENTIALS_ENABLED": "true",
    "BANK_NAME": "MB Bank",
    "BANK_BIN": "970422",
    "BANK_ACCOUNT": "5565662518"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/android/*"]
  },

  "routes": [
    { "pattern": "locketgold.info", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locketgold-db",
      "database_id": "fc247c70-d967-4a1b-a492-2e2620c8475f",
      "migrations_dir": "migrations"
    }
  ]
}
